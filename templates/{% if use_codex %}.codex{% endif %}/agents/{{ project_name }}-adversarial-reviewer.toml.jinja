name = "{{ project_name }}-adversarial-reviewer"
description = "Read-only adversarial reviewer for {{ project_name }} plans, diffs, PRs, architecture, design-system, tests, and execution evidence."
sandbox_mode = "read-only"
model_reasoning_effort = "high"

