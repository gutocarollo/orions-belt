# Banlist of internal jargon for CLIENT documents (one ERE per line; # = comment).
# The deliverable-scrub-gate hook runs these patterns against Write/Edit on files
# whose path matches one of the globs below. Goal: never leak internal process /
# tool name / another account's context into a client deliverable.
# Origin: friction audit of the reference donor harness, cluster 7 ("NEVER MENTIONS THE INTERNAL
# PROJECT NAME", internal jargon in a client doc). Generic seed — customize the
# globs/terms below to this project's client-doc naming convention.

# --- target-file globs (prefix 'glob:'; relative to the repo root) ---
glob: docs/commercial/Proposta-*
glob: docs/commercial/Orcamento-*
glob: docs/commercial/Relatorio-*
glob: docs/commercial/RELATORIO-*
glob: docs/commercial/Cronograma*
glob: docs/commercial/Matriz-*
glob: docs/commercial/manual-usuario/*

# --- banned patterns (ERE, case-insensitive) ---
\bLEI ZERO\b
CLAUDE\.md
\bhookify\b
\bsubagents?\b
\bworkflow de (sub)?agentes?\b
\bonda [0-9]
pós-auditoria
auditoria adversarial
\bClaude Code\b
vscode-webview://
{%- if client_product_name %}
# internal project name: the product for the client is "{{ client_product_name }}"
{%- else %}
# internal project name (customize/add the commercial name of the product delivered to the client):
{%- endif %}
\b{{ project_name }}\b
