#!/usr/bin/env bash
# Canonical changed-files generator for Understand Anything over {{ harness_understand_apps_root }}/.
#
# MATERIALIZATION (R2, orions-belt — rescue plan §2 item "Lint
# distribution"): genericized port of the canonical script from the
# reference donor harness (which lived in `scripts/understand-apps-changed-files.sh`,
# with "apps" hardcoded in place of {{ harness_understand_apps_root }}). Only
# generated when `harness_understand_apps_root` is set (see copier.yml)
# — the project uses a monorepo subdirectory, not the git root, as the
# PROJECT_ROOT of the Understand Anything graph (see
# docs/planning/notas-f1.6.md). Materialized in `.harness/lib/`, the SAME
# directory where `_tooling_conf.py`/`scan_project.py`/`ds-gate.sh` are already
# installed into the target project (F0/F5) — not a separate top-level
# `scripts/`, to avoid colliding with the target project's own scripts and to
# keep a single namespace for everything the framework materializes. `AGENTS.md.jinja`,
# the `understand-apps-incremental` skill, the `{{ project_name }}-delivery-council`
# skill and the `understand-apps-diff-guard.sh`/`understand-context-inject.py`
# hooks referenced this command as `bash scripts/understand-apps-changed-files.sh`
# before it existed anywhere in the target project — a phantom path
# fixed together with this materialization.
#
# Why this exists:
# - The Git repo root may differ from the Understand Anything graph root.
# - The Understand Anything graph root is {{ harness_understand_apps_root }}/ (relative to the Git root).
# - A raw `git diff <last>..HEAD --name-only` emits `{{ harness_understand_apps_root }}/api/...`.
# - The graph stores paths as `api/...`, `web/...`, etc. (relative to {{ harness_understand_apps_root }}/).
# Therefore every incremental run over {{ harness_understand_apps_root }}/ MUST use
# `git diff --relative={{ harness_understand_apps_root }}`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
APP_ROOT="$ROOT/{{ harness_understand_apps_root }}"
META="$APP_ROOT/.understand-anything/meta.json"
OUT="${1:-$APP_ROOT/.understand-anything/tmp/changed-files.txt}"

if [ ! -f "$META" ]; then
  echo "UNDERSTAND-APPS-DIFF: missing $META; cannot compute incremental diff." >&2
  exit 2
fi

LAST="$(
  node -e "const fs=require('fs'); const m=JSON.parse(fs.readFileSync(process.argv[1], 'utf8')); process.stdout.write(m.gitCommitHash || '');" "$META"
)"

if [ -z "$LAST" ]; then
  echo "UNDERSTAND-APPS-DIFF: meta.json has no gitCommitHash." >&2
  exit 2
fi

mkdir -p "$(dirname "$OUT")"

git -C "$ROOT" diff --relative={{ harness_understand_apps_root }} "$LAST"..HEAD --name-only -- {{ harness_understand_apps_root }} \
  | awk '!/^\.understand-anything\//' \
  > "$OUT"

if grep -Eq '^({{ harness_understand_apps_root }}/|\.claude/|\.agents/|\.codex/|docs/|scripts/|infra/|docker/|\.github/)' "$OUT"; then
  echo "UNDERSTAND-APPS-DIFF: invalid non-app-relative paths in $OUT." >&2
  echo "The file must contain paths like api/... or web/..., never {{ harness_understand_apps_root }}/api/... or repo-root paths." >&2
  grep -En '^({{ harness_understand_apps_root }}/|\.claude/|\.agents/|\.codex/|docs/|scripts/|infra/|docker/|\.github/)' "$OUT" | sed -n '1,20p' >&2
  exit 2
fi

COUNT="$(wc -l < "$OUT" | tr -d ' ')"
echo "UNDERSTAND-APPS-DIFF: wrote $COUNT app-relative changed files to $OUT"
echo "UNDERSTAND-APPS-DIFF: last analyzed commit $LAST"
