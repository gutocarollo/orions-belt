#!/usr/bin/env bash
# Canonical changed-files generator for Understand Anything over {{ harness_understand_apps_root }}/.
#
# MATERIALIZATION (R2, orions-belt — rescue plan §2 item "Lint
# distribution"): genericized port of the canonical script from the
# reference donor harness (which lived in `scripts/understand-apps-changed-files.sh`,
# with "apps" hardcoded in place of {{ harness_understand_apps_root }}). Only
# generated when `harness_understand_apps_root` is set (see copier.yml)
# — the project uses a monorepo subdirectory, not the git root, as the
# PROJECT_ROOT of the Understand Anything graph (see
# docs/planning/notas-f1.6.md). Materialized in `.harness/lib/`, the SAME
# directory where `_tooling_conf.py`/`scan_project.py`/`ds-gate.sh` are already
# installed into the target project (F0/F5) — not a separate top-level
# `scripts/`, to avoid colliding with the target project's own scripts and to
# keep a single namespace for everything the framework materializes. `AGENTS.md.jinja`,
# the `understand-apps-incremental` skill, the `{{ project_name }}-delivery-council`
# skill and the `understand-apps-diff-guard.sh`/`understand-context-inject.py`
# hooks referenced this command as `bash scripts/understand-apps-changed-files.sh`
# before it existed anywhere in the target project — a phantom path
# fixed together with this materialization.
#
# Why this exists:
# - The Git repo root may differ from the Understand Anything graph root.
# - The Understand Anything graph root is {{ harness_understand_apps_root }}/ (relative to the Git root).
# - A raw `git diff <last>..HEAD --name-only` emits `{{ harness_understand_apps_root }}/api/...`.
# - The graph stores paths as `api/...`, `web/...`, etc. (relative to {{ harness_understand_apps_root }}/).
# Therefore every incremental run over {{ harness_understand_apps_root }}/ MUST use
# `git diff --relative={{ harness_understand_apps_root }}`.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
APP_ROOT="$ROOT/{{ harness_understand_apps_root }}"
META="$APP_ROOT/.understand-anything/meta.json"
OUT="${1:-$APP_ROOT/.understand-anything/tmp/changed-files.txt}"

if [ ! -f "$META" ]; then
  echo "UNDERSTAND-APPS-DIFF: missing $META; cannot compute incremental diff." >&2
  exit 2
fi

LAST="$(
  node -e "const fs=require('fs'); const m=JSON.parse(fs.readFileSync(process.argv[1], 'utf8')); process.stdout.write(m.gitCommitHash || '');" "$META"
)"

if [ -z "$LAST" ]; then
  echo "UNDERSTAND-APPS-DIFF: meta.json has no gitCommitHash." >&2
  exit 2
fi

mkdir -p "$(dirname "$OUT")"

git -C "$ROOT" diff --relative={{ harness_understand_apps_root }} "$LAST"..HEAD --name-only -- {{ harness_understand_apps_root }} \
  | awk '!/^\.understand-anything\//' \
  > "$OUT"

# GUARD BY RESOLUTION, NOT BY DIRECTORY NAME (adopter report, 2026-07-30). The previous guard
# rejected any line starting with `docs/`, `scripts/`, `infra/`, `docker/`, `.claude/`, `.agents/`,
# `.codex/` or `.github/` — treating those names as proof of a repo-root path. But an app root
# legitimately contains its own `docs/` and `scripts/`: measured in a real adopter whose graph root
# holds both, EVERY commit that touched documentation made this script exit 2, and the failure was
# read as "N files pending" because the script writes $OUT before the guard runs. A guard that
# fires on a correct input is worse than no guard: it trains the operator to ignore the exit code.
# The bug class the guard exists for is the DOUBLE PREFIX (`{{ harness_understand_apps_root }}/api/...`
# emitted by a diff without --relative); that check stays, by name, because it is unambiguous.
# Everything else is decided by RESOLUTION: an app-relative path resolves under $APP_ROOT in the
# worktree or in HEAD; a repo-root path does not. Name-independent, so it cannot false-positive on
# a directory that happens to share a name with a repo-root one.
BAD_PREFIX="$(grep -En '^{{ harness_understand_apps_root }}/' "$OUT" | sed -n '1,20p' || true)"
if [ -n "$BAD_PREFIX" ]; then
  echo "UNDERSTAND-APPS-DIFF: double-prefixed paths in $OUT (diff ran without --relative)." >&2
  echo "Paths must be relative to {{ harness_understand_apps_root }}/ — api/... not {{ harness_understand_apps_root }}/api/..." >&2
  printf '%s\n' "$BAD_PREFIX" >&2
  exit 2
fi

UNRESOLVED=""
while IFS= read -r rel; do
  [ -n "$rel" ] || continue
  [ -e "$APP_ROOT/$rel" ] && continue
  # A path present in the diff exists in at least ONE of the two endpoints by definition, so both
  # must be consulted: checking only HEAD would flag every file DELETED between the seal and HEAD
  # as unresolved — a legitimate app-relative path and a real regression caught while testing this.
  git -C "$ROOT" cat-file -e "HEAD:{{ harness_understand_apps_root }}/$rel" 2>/dev/null && continue
  git -C "$ROOT" cat-file -e "$LAST:{{ harness_understand_apps_root }}/$rel" 2>/dev/null && continue
  UNRESOLVED="$UNRESOLVED$rel
"
done < "$OUT"
if [ -n "$UNRESOLVED" ]; then
  echo "UNDERSTAND-APPS-DIFF: paths in $OUT do not resolve under $APP_ROOT (neither in the worktree nor at HEAD)." >&2
  echo "They are repo-root paths, not app-relative ones. The file must contain api/... or web/..., relative to {{ harness_understand_apps_root }}/." >&2
  printf '%s' "$UNRESOLVED" | sed -n '1,20p' >&2
  exit 2
fi

COUNT="$(wc -l < "$OUT" | tr -d ' ')"
echo "UNDERSTAND-APPS-DIFF: wrote $COUNT app-relative changed files to $OUT"
echo "UNDERSTAND-APPS-DIFF: last analyzed commit $LAST"

# CODE vs DOC-ONLY SPLIT (adopter report, 2026-07-30). The raw count above answers "how many files
# changed", which is NOT the same question as "is the graph stale". Measured in a real adopter: the
# script reported 48 pending while the graph held 676 file nodes and ZERO markdown — all 48 changes
# were documentation, so the graph was semantically current and only its commit seal was behind.
# A freshness signal that cannot reach zero by any amount of work teaches the agent to ignore it,
# which is worse than no signal. The output file is deliberately NOT filtered: what a given graph
# backend indexes is its business, and a JS/Python project may legitimately index more than this
# default. Override the doc-only pattern with HARNESS_UNDERSTAND_DOC_ONLY_RE when your backend
# indexes prose (a knowledge graph over a wiki, for instance).
DOC_ONLY_RE="${HARNESS_UNDERSTAND_DOC_ONLY_RE:-\.(md|mdx|markdown|txt|rst|adoc|csv|pdf)$|^docs/}"
DOC_COUNT="$(grep -Ec "$DOC_ONLY_RE" "$OUT" || true)"
CODE_COUNT=$((COUNT - DOC_COUNT))
echo "UNDERSTAND-APPS-DIFF: of these, $DOC_COUNT are documentation-only and $CODE_COUNT touch code"
if [ "$COUNT" -gt 0 ] && [ "$CODE_COUNT" -eq 0 ]; then
  echo "UNDERSTAND-APPS-DIFF: NO code changed since the seal — the graph is semantically CURRENT."
  echo "UNDERSTAND-APPS-DIFF: only meta.json's gitCommitHash is behind HEAD. Do not read the $COUNT above as staleness."
fi
