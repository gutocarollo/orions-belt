{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context plan result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "skill",
    "plan_id",
    "task_shape",
    "risk_tier",
    "claims_completeness",
    "required_methods",
    "method_stages",
    "dependency_edges",
    "parallel_groups",
    "parallel_shards",
    "allowed_agent_types",
    "allowed_models"
  ],
  "properties": {
    "status": {"const": "PRONTO"},
    "skill": {"const": "context-delivery"},
    "plan_id": {"type": "string", "minLength": 1},
    "task_shape": {
      "enum": [
        "LEXICAL_ENUMERATION",
        "KNOWN_SYMBOL_IMPACT",
        "DYNAMIC_STATE_FLOW",
        "DOCS_OR_CONFIG",
        "LIVE_STATE",
        "DIRECT_TARGETED"
      ]
    },
    "risk_tier": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "claims_completeness": {"type": "boolean"},
    "required_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["canonical-docs", "rg", "targeted-read", "codegraph", "lsp", "live-state"]
      }
    },
    "method_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "stage"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "stage": {"type": "integer", "minimum": 0}
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["before", "after"],
        "properties": {
          "before": {"type": "string", "minLength": 1},
          "after": {"type": "string", "minLength": 1}
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "parallel_shards": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_agent_types": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_models": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
