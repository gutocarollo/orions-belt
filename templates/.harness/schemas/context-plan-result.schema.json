{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context plan result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "skill",
    "plan_id",
    "task_shape",
    "risk_tier",
    "claims_completeness",
    "predicates",
    "canonical_docs",
    "required_methods",
    "conditional_methods",
    "method_stages",
    "dependency_edges",
    "parallel_groups",
    "parallel_shards",
    "allowed_agent_types",
    "allowed_models",
    "tool_matchers",
    "provider_requirements"
  ],
  "properties": {
    "status": {
      "const": "PRONTO"
    },
    "skill": {
      "const": "context-delivery"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "council_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "base_sha", "repository_fingerprint"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "task_shape": {
      "enum": [
        "LEXICAL_ENUMERATION",
        "KNOWN_SYMBOL_IMPACT",
        "DYNAMIC_STATE_FLOW",
        "DOCS_OR_CONFIG",
        "LIVE_STATE",
        "DIRECT_TARGETED"
      ]
    },
    "risk_tier": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "claims_completeness": {
      "type": "boolean"
    },
    "predicates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ],
      "properties": {
        "P1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "P2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "P3": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "P4": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "P5": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "P6": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status",
            "source",
            "command",
            "evidence"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                true,
                false,
                "UNKNOWN",
                "NOT_APPLICABLE",
                "DEFERRED"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "command": {},
            "evidence": {
              "type": "array",
              "items": {}
            },
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "threshold": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "canonical_docs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "canonical-docs",
          "rg",
          "targeted-read",
          "codegraph-status",
          "codegraph",
          "lsp",
          "live-state"
        ]
      }
    },
    "conditional_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "when_predicate",
          "equals"
        ],
        "properties": {
          "method": {
            "enum": [
              "lsp"
            ]
          },
          "when_predicate": {
            "enum": [
              "P4"
            ]
          },
          "equals": {
            "type": "boolean"
          }
        }
      }
    },
    "method_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "stage"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "before",
          "after"
        ],
        "properties": {
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "parallel_shards": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_agent_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tool_matchers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "patterns"
        ],
        "properties": {
          "method": {
            "type": "string",
            "minLength": 1
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "provider_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codegraph_freshness_required",
        "provider_status_tool_required"
      ],
      "properties": {
        "codegraph_freshness_required": {
          "type": "boolean"
        },
        "provider_status_tool_required": {
          "type": "boolean"
        }
      }
    }
  }
}
