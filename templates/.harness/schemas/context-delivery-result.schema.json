{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Context delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "skill",
    "plan_id",
    "runtime",
    "agent_id",
    "agent_type",
    "model",
    "lifecycle_receipt",
    "artifacts",
    "provider_state",
    "coverage",
    "claims",
    "unresolved_items"
  ],
  "properties": {
    "status": {"const": "SATISFEITO"},
    "skill": {"const": "context-delivery"},
    "plan_id": {"type": "string", "minLength": 1},
    "runtime": {"enum": ["claude", "codex"]},
    "agent_id": {"type": "string", "minLength": 1},
    "agent_type": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "lifecycle_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "path", "sha256", "stage"],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "stage": {"type": "integer", "minimum": 0}
        }
      }
    },
    "provider_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "status", "index_fresh", "pending_changes"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "status": {"enum": ["AVAILABLE", "UNAVAILABLE", "NOT_REQUIRED"]},
        "index_fresh": {"type": "boolean"},
        "pending_changes": {"type": "integer", "minimum": 0}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_files", "analyzed_files", "candidates", "confirmed", "false_positives", "unresolved"],
      "properties": {
        "eligible_files": {"type": "integer", "minimum": 0},
        "analyzed_files": {"type": "integer", "minimum": 0},
        "candidates": {"type": "integer", "minimum": 0},
        "confirmed": {"type": "integer", "minimum": 0},
        "false_positives": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "evidence"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
