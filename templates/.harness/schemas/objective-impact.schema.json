{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Objective impact assessment","type":"object","additionalProperties":false,"required":["id","evidence_status","evidence","objective_impact","journey_reachability","acceptance_impact","irreversibility","dependency_urgency","on_critical_path","affects_current_phase","validated_workaround","graph_nodes","score","disposition"],"properties":{"id":{"type":"string","minLength":1},"evidence_status":{"enum":["REAL","UNVERIFIED","REFUTED"]},"evidence":{"type":"string","minLength":1},"objective_impact":{"type":"integer","minimum":0,"maximum":4},"journey_reachability":{"type":"integer","minimum":0,"maximum":4},"acceptance_impact":{"type":"integer","minimum":0,"maximum":4},"irreversibility":{"type":"integer","minimum":0,"maximum":4},"dependency_urgency":{"type":"integer","minimum":0,"maximum":4},"on_critical_path":{"type":"boolean"},"affects_current_phase":{"type":"boolean"},"validated_workaround":{"type":"boolean"},"hard_safety_boundary":{"type":"boolean"},"graph_nodes":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"score":{"type":"number","minimum":0,"maximum":100},"disposition":{"enum":["CRITICAL_BLOCK","HIGH_FIX_NOW","DEFER_RUN"]}}}
