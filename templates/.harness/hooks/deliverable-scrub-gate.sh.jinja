#!/usr/bin/env bash
# deliverable-scrub-gate — PostToolUse (Write|Edit|MultiEdit).
# If the written file is a CLIENT DOC (banlist glob) and its content contains
# banned internal jargon, it returns the violation as feedback (exit 2). It does
# not block the write (already happened); it warns you to fix it before delivering
# or generating a PDF. Origin: friction audit 2026-07-03, cluster 7.
#
# MATERIALIZATION (F4, orions-belt): the banlist stays at
# .claude/deliverable-banlist.txt (not moved to .harness/) — the same
# Claude-namespaced convention the deliverable-contract skill already uses for
# .claude/contracts/. In a use_claude=false/use_codex=true project the file does
# not exist and the hook is fail-open (line below) — the mechanism is not yet
# generalized to both runtimes; a known limitation, not a crash.
set -uo pipefail
IN=$(cat)
command -v jq >/dev/null 2>&1 || exit 0
FP=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty' <<<"$IN")
[ -n "$FP" ] || exit 0
ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
BAN="$ROOT/.claude/deliverable-banlist.txt"
[ -f "$BAN" ] || exit 0
REL="${FP#$ROOT/}"

# 1) does the file match any client-doc glob?
match=0
while IFS= read -r line; do
  case "$line" in
    "glob: "*) g="${line#glob: }"; case "$REL" in $g) match=1; break ;; esac ;;
  esac
done < "$BAN"
[ "$match" -eq 0 ] && exit 0
[ -f "$FP" ] || exit 0

# 2) run the banned patterns against the file's current content
HITS=""
while IFS= read -r pat; do
  case "$pat" in ''|'#'*|'glob: '*) continue ;; esac
  found=$(grep -niE "$pat" "$FP" 2>/dev/null | head -3)
  [ -n "$found" ] && HITS+="  [$pat]\n$found\n"
done < "$BAN"
[ -z "$HITS" ] && exit 0

{
  echo "DELIVERABLE-SCRUB: internal jargon in a CLIENT document ($REL)."
  echo "The client-facing product is \"{% if client_product_name %}{{ client_product_name }}{% else %}{{ project_name }}{% endif %}\" — internal process, tool names and other-account context do not belong in the deliverable."
  echo -e "Occurrences:\n$HITS"
  echo "Remove/rewrite before generating a PDF or delivering. The user's negative constraint holds VERBATIM (do not convert it into a positive item)."
} >&2
exit 2
