#!/usr/bin/env bash
# ds-gate-posttool — PostToolUse (Edit|Write|MultiEdit).
# Design system feedback SECONDS after the edit, not days later in a
# human review: runs the ratchet .harness/lib/ds-gate.sh (9 dimensions,
# baseline by ratchet) and the pairs contract .harness/lib/ds-pairs-check.py
# whenever a UI file changes inside HARNESS_WEB_APP_DIR.
# exit 2 = the violation goes as feedback to the model (the turn continues).
# Origin: apps/web/scripts/{ds-gate.sh,ds-pairs-check.py} from the reference
# donor harness (real friction audit, cluster 5 — canon not applied).
#
# GATED by `use_ds_gate` (copier.yml): when false, this file is not even
# GENERATED — the condition-in-the-filename pattern (same as
# `ui-evidence-gate.sh.jinja`/`understand-apps-diff-guard.sh.jinja`) — and the
# registration in settings.json/hooks.json disappears along with it (both also gated by
# `use_ds_gate`). Double guarantee: even if the registration survived on its own,
# this script would never exist to be called.
#
# REGRESSION FIXED (rescue plan §1, item 1): the previous version
# registered this hook UNCONDITIONALLY and called `bash scripts/ds-gate.sh`
# relative to apps/web WITHOUT porting the script to the target project — every
# generated project hit `bash: scripts/ds-gate.sh: No such file or directory` (exit
# 127) on every Edit/Write. Now the engine lives in `.harness/lib/` (always
# installed, fixed path, generic — see ds-gate.sh/ds-pairs-check.py) and the
# web app directory is read at RUNTIME from `.harness/harness.conf`
# (HARNESS_WEB_APP_DIR, default ".") instead of the hardcoded "apps/web" — same
# design choice as `ui-evidence-gate.sh.jinja` (read at runtime via
# _tooling_conf.py, not baked via Jinja substitution, so as not to require
# `copier update` just to propagate a manual edit of the .conf).
set -uo pipefail
IN=$(cat)
command -v jq >/dev/null 2>&1 || exit 0
FP=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty' <<<"$IN")
[ -n "$FP" ] || exit 0

ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
[ -n "$ROOT" ] || exit 0
cd "$ROOT" || exit 0

CONF_PY="$ROOT/.harness/lib/_tooling_conf.py"
_conf_get() {
  local val
  if command -v python3 >/dev/null 2>&1 && [ -f "$CONF_PY" ]; then
    val="$(HARNESS_PROJECT_ROOT="$ROOT" python3 "$CONF_PY" get "$1" "$2" 2>/dev/null)"
    [ -n "$val" ] && { echo "$val"; return 0; }
  fi
  echo "$2"
}

WEB_APP_DIR="$(_conf_get HARNESS_WEB_APP_DIR .)"
WEB_APP_DIR="${WEB_APP_DIR%/}"
[ -z "$WEB_APP_DIR" ] && WEB_APP_DIR="."

# only UI files (.tsx/.ts/.css); if HARNESS_WEB_APP_DIR != "." (monorepo),
# also require that the path contains that subdirectory.
case "$FP" in
  *.tsx|*.css|*.ts) ;;
  *) exit 0 ;;
esac
if [ "$WEB_APP_DIR" != "." ]; then
  case "$FP" in
    */"$WEB_APP_DIR"/*|"$WEB_APP_DIR"/*) ;;
    *) exit 0 ;;
  esac
fi

WEB_DIR="$ROOT"
[ "$WEB_APP_DIR" != "." ] && WEB_DIR="$ROOT/$WEB_APP_DIR"
[ -d "$WEB_DIR" ] || exit 0   # this stack's layout does not have the expected web app — fail-open

LIB="$ROOT/.harness/lib"
[ -f "$LIB/ds-gate.sh" ] && [ -f "$LIB/ds-pairs-check.py" ] || exit 0   # engine missing (partial install) — fail-open

FAIL=0; MSG=""
GATE=$(bash "$LIB/ds-gate.sh" 2>&1) || { FAIL=1; MSG+="ds-gate (tokenization ratchet) FAILED:\n$(tail -12 <<<"$GATE")\n"; }
PAIRS=$(python3 "$LIB/ds-pairs-check.py" 2>&1) || { FAIL=1; MSG+="ds-pairs-check (label/contrast contract) FAILED:\n$(grep -v ' OK$' <<<"$PAIRS" | tail -10)\n"; }
[ "$FAIL" -eq 0 ] && exit 0

{
  echo "DS-GATE: the edit in $FP introduced a design system violation."
  echo -e "$MSG"
  echo "Rules: hardcoded values -> token."
  echo "Legitimate and justified exception: comment '// ds-allow: <reason>' on the line, or a glob in ${WEB_APP_DIR}/.ds-allowlist."
} >&2
exit 2
