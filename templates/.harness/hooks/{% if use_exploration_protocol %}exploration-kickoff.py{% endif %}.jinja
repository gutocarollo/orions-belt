#!/usr/bin/env python3
"""exploration-kickoff — UserPromptSubmit hook (generated by orions-belt).

When the prompt looks like the start of a substantive task (implement, fix, audit, investigate,
plan, review), inject the compact exploration routing so every session starts from the same
canonical docs and tools instead of inventing its own route. Full protocol: the
`exploration-protocol` skill.

SIBLING OF lei-zero-kickoff.py, same mechanism (UserPromptSubmit stdout becomes model context),
COMPLEMENTARY payload: lei-zero injects the REUSE law ("do not reinvent"), this one injects the
ROUTING map ("read in this order"). Neither is a subset of the other.

WHY A HOOK AND NOT ONLY PROSE (measured in the donor project, 2026-07-30): 23 living reference
pages were created in a single commit and never routed — grepping the main 16 across the 6 entry
points returned ZERO in all six. Instructions the agent must remember to re-read are obeyed only
when it happens to remember. The injection puts the route in front of the task, at the moment the
route is needed.

CONDITIONAL BY CONTENT, like every prompt hook here: a rule injected on every prompt competes for
context with the real work. Silent on short prompts and on prompts that already named the protocol.

THE BODY BELOW IS RENDERED AT INSTALL TIME. Phases whose parameter is empty are not emitted at all
— a route pointing at nothing trains the agent to skim the block.

Fail-open: any error -> exit 0 with no output.
"""
import json
import re
import sys

KICKOFF_RE = re.compile(
    r"(?i)\b("
    # build/change
    r"implement|build\s+a|add\s+(a\s+)?feature|create|refactor|migrate|fix\b|repair"
    # investigate/judge
    r"|investigate|audit|analy[sz]e|diagnose|debug|review|verify|check\b"
    # plan
    r"|plan\b|design\s+(the\s+)?architecture"
    # portuguese
    r"|implemente|implementar|desenvolv[ae]|crie|criar|adicione|adicionar"
    r"|refator[ae]|migr[ae]r?|constru[ai]|corrij[ao]|corrigir|conserte"
    r"|audite|auditar|auditoria|investigu?e|investigar|analis[ea]|analisar"
    r"|diagnostiqu?e|diagnosticar|depur[ea]|revis[ea]|revisar|verifiqu?e|verificar"
    r"|planej[ea]|planejar|monte\s+um\s+plano|desenh[ea]\s+(a\s+)?arquitetura"
    r")\b"
)
# Short prompts ("continue", "ok", "go on") are not a kickoff. Same threshold as lei-zero-kickoff.
MIN_LEN = 25

SKILL = "exploration-protocol"

ROUTING = """<exploration-protocol-kickoff>
EXPLORATION STANDARD (mandatory before any plan, verdict or clarification — full protocol: skill `exploration-protocol`):
- F0 anchor: the ORIGINAL request, not the paraphrase that survived compaction (`.harness/requests/`).
{%- if harness_entry_docs %}
- F1 canonical docs IN ORDER: {{ harness_entry_docs.split(',') | map('trim') | select | join(' -> ') }}.
{%- endif %}
{%- if harness_reference_index %}
- F1-bis LIVING REFERENCE: read the subsystem page listed in `{{ harness_reference_index }}` BEFORE touching that subsystem's code. A page banner-marked historical is genealogy, never source.
{%- endif %}
{%- if use_context_graph %}
- F2 code — the fork is MANDATORY and PARALLEL, never sequential: code graph IN PARALLEL WITH `rg -n "<symbol>"`. Measured complementary failure: the graph loses by-REFERENCE passage (a callback/test fixture is not a call edge) and resolves callees by NAME (may point at a test stub); grep never separates homonyms nor names the enclosing function. Serialising is pure latency.
{%- else %}
- F2 code — `rg -n "<symbol>"` plus targeted reads. Know the gap: grep never separates homonymous definitions, never names the enclosing function and never follows an indirect chain; promote the verdict to the LSP (F4) when that decides it.
{%- endif %}
{%- if harness_understand_apps_root %}
  Architecture: Understand Anything graph at `{{ harness_understand_apps_root }}/.understand-anything/` — scope `{{ harness_understand_apps_root }}/` ONLY; freshness via `bash .harness/lib/understand-apps-changed-files.sh`.
{%- endif %}
  NO code graph indexes Markdown — never conclude "there is no doc about X" from a graph miss; documentation is found by the routes above.
{%- if harness_mcp_db_dev_port and harness_mcp_db_dev_port > 0 %}
- F3 live state: query the database MCP whenever state/persisted data/eval is involved — DISTINCT/counts before inferring. A permission error is NOT absence of data (it is the wrong endpoint/role); declared config is NOT produced behaviour (measure the effect, not the flag).
{%- endif %}
- F4 LSP find_referencing_symbols AFTER the join — only there do you know which edge decides the verdict; mandatory when the graph reports homonyms.
- F5 official, current docs for any external library/SDK/CLI; never training knowledge for API, version or config.
- Clarification questions only AFTER the phases above. When one is truly needed its contract is the `clarification-plan` skill — loaded, not cited.
{%- if use_context_graph %}
- Diff-time handoff: once the question becomes "what breaks if I change this", the ⭐ context tooling decision graph block in the project instructions takes over (predicates P1-P4, fork/join, adversarial loop in a subagent).
{%- else %}
- Diff-time handoff: once the question becomes "what breaks if I change this", prefer LSP and regression tests over more reading.
{%- endif %}
</exploration-protocol-kickoff>"""


def main():
    try:
        data = json.load(sys.stdin)
        prompt = data.get("prompt") or ""
    except Exception:  # noqa: BLE001 - fail-open, see module docstring
        return 0
    if len(prompt) < MIN_LEN:
        return 0
    # The user already named the protocol explicitly; do not duplicate it.
    if SKILL in prompt.lower():
        return 0
    if not KICKOFF_RE.search(prompt):
        return 0
    print(ROUTING)
    return 0


if __name__ == "__main__":
    sys.exit(main())
