#!/usr/bin/env python3
"""Inject compact exploration guidance for substantive task starts."""
from __future__ import annotations

import json
import re
import sys

KICKOFF_RE = re.compile(
    r"(?i)\b(implement|build\s+a|add\s+(a\s+)?feature|create|refactor|migrate|fix\b|repair"
    r"|investigate|audit|analy[sz]e|diagnose|debug|review|verify|check\b|plan\b|design\s+(the\s+)?architecture"
    r"|implemente|implementar|desenvolv[ae]|crie|criar|adicione|adicionar|refator[ae]|migr[ae]r?"
    r"|constru[ai]|corrij[ao]|corrigir|conserte|audite|auditar|auditoria|investigu?e|investigar"
    r"|analis[ea]|analisar|diagnostiqu?e|diagnosticar|depur[ea]|revis[ea]|revisar|verifiqu?e"
    r"|verificar|planej[ea]|planejar|monte\s+um\s+plano|desenh[ea]\s+(a\s+)?arquitetura)\b"
)
MIN_LEN = 25

ROUTING = """<exploration-protocol-kickoff>
EXPLORATION STANDARD — use the smallest route that can answer the task.
- F0: preserve the ORIGINAL request and observable DONE-WHEN.
{%- if harness_entry_docs %}
- F1 docs, in order: {{ harness_entry_docs.split(',') | map('trim') | select | join(' -> ') }}.
{%- endif %}
{%- if harness_reference_index %}
- F1-bis: route living subsystem docs through `{{ harness_reference_index }}`.
{%- endif %}
- F2/F4: lexical enumeration = `rg` first; known high-radius symbol = graph ∥ `rg`; dynamic flow = local state/data proof before graph/LSP.
{%- if harness_mcp_db_dev_port and harness_mcp_db_dev_port > 0 %}
- F3: use read-only live state when persisted behavior matters.
{%- endif %}
- F5: current official docs for external APIs/SDKs/CLIs.
- Prefer DIRECT; use LIGHT for useful coordination; use FULL/context-delivery only for material high-assurance risk.
</exploration-protocol-kickoff>"""


def main() -> int:
    try:
        data = json.load(sys.stdin)
        prompt = str(data.get("prompt") or "")
    except Exception:
        return 0
    if len(prompt) < MIN_LEN:
        return 0
    lowered = prompt.lower()
    if "exploration-protocol" in lowered or "context-delivery" in lowered:
        return 0
    if KICKOFF_RE.search(prompt):
        print(ROUTING)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
