#!/usr/bin/env python3
"""Inject adaptive Context Delivery routing at substantive task start."""
import json
import re
import sys

KICKOFF_RE = re.compile(
    r"(?i)\b(implement|build\s+a|add\s+(a\s+)?feature|create|refactor|migrate|fix\b|repair"
    r"|investigate|audit|analy[sz]e|diagnose|debug|review|verify|check\b|plan\b|design\s+(the\s+)?architecture"
    r"|implemente|implementar|desenvolv[ae]|crie|criar|adicione|adicionar|refator[ae]|migr[ae]r?"
    r"|constru[ai]|corrij[ao]|corrigir|conserte|audite|auditar|auditoria|investigu?e|investigar"
    r"|analis[ea]|analisar|diagnostiqu?e|diagnosticar|depur[ea]|revis[ea]|revisar|verifiqu?e"
    r"|verificar|planej[ea]|planejar|monte\s+um\s+plano|desenh[ea]\s+(a\s+)?arquitetura)\b"
)
MIN_LEN = 25
SKILL = "exploration-protocol"

ROUTING = """<context-delivery-kickoff>
ADAPTIVE EXPLORATION — before planning, classify the task and persist CONTEXT-PLAN with skill `context-delivery`.
- F0: preserve the ORIGINAL request from `.harness/requests/`.
{%- if harness_entry_docs %}
- Canonical docs first, in order: {{ harness_entry_docs.split(',') | map('trim') | select | join(' -> ') }}.
{%- endif %}
{%- if harness_reference_index %}
- Read the living subsystem reference routed by `{{ harness_reference_index }}` before treating its code as authority.
{%- endif %}
- `LEXICAL_ENUMERATION`: shard `rg` discovery in non-overlapping scopes; classify candidates; only then use graph/LSP for candidate-to-entrypoint reachability.
- `KNOWN_SYMBOL_IMPACT`: a known high-radius/completeness symbol uses CodeGraph ∥ `rg`; a low-radius leaf uses one semantic route plus focused verification.
- `DYNAMIC_STATE_FLOW`: prove event -> state/data -> behavior locally before graph reachability.
- `DOCS_OR_CONFIG`: canonical docs + textual search + focused reads.
{%- if harness_mcp_db_dev_port and harness_mcp_db_dev_port > 0 %}
- `LIVE_STATE`: read-only database/runtime evidence ∥ relevant code. Permission failure is not absence.
{%- endif %}
- LSP/Serena is an escalation for identity, alias/re-export or conflicting decisive edges; it is not a universal parallel branch.
- Record provider freshness, every skipped method, coverage and unresolved items. A stale graph cannot support an exhaustive claim.
- For WORKSPACE_WRITE Council runs: ANCHOR -> CONTEXT-PLAN -> CONTEXT-DELIVERY -> PHASE-PLAN.
</context-delivery-kickoff>"""


def main() -> int:
    try:
        data = json.load(sys.stdin)
        prompt = data.get("prompt") or ""
    except Exception:
        return 0
    if len(prompt) < MIN_LEN or SKILL in prompt.lower() or "context-delivery" in prompt.lower():
        return 0
    if KICKOFF_RE.search(prompt):
        print(ROUTING)
    return 0


if __name__ == "__main__":
    sys.exit(main())
