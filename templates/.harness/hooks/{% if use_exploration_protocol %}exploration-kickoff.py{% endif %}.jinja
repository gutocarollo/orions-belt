#!/usr/bin/env python3
"""Inject the repository's adaptive exploration order at task start.

This remains a prompt injection, not evidence that exploration executed. When
Context Delivery is enabled, the executable Council transition is the proof.
"""
from __future__ import annotations

import json
import re
import sys

KICKOFF_RE = re.compile(
    r"(?i)\b(implement|build\s+a|add\s+(a\s+)?feature|create|refactor|migrate|fix\b|repair"
    r"|investigate|audit|analy[sz]e|diagnose|debug|review|verify|check\b|plan\b|design\s+(the\s+)?architecture"
    r"|implemente|implementar|desenvolv[ae]|crie|criar|adicione|adicionar|refator[ae]|migr[ae]r?"
    r"|constru[ai]|corrij[ao]|corrigir|conserte|audite|auditar|auditoria|investigu?e|investigar"
    r"|analis[ea]|analisar|diagnostiqu?e|diagnosticar|depur[ea]|revis[ea]|revisar|verifiqu?e"
    r"|verificar|planej[ea]|planejar|monte\s+um\s+plano|desenh[ea]\s+(a\s+)?arquitetura)\b"
)
MIN_LEN = 25

ROUTING = """<exploration-protocol-kickoff>
EXPLORATION STANDARD — prompt guidance only; executable proof comes from `context-delivery` when enabled.
- F0: anchor the ORIGINAL request from `.harness/requests/`; do not substitute a derived plan.
{%- if harness_entry_docs %}
- F1 canonical docs, in order: {{ harness_entry_docs.split(',') | map('trim') | select | join(' -> ') }}.
{%- endif %}
{%- if harness_reference_index %}
- F1-bis: read the living subsystem page routed by `{{ harness_reference_index }}` before treating its code as authority.
{%- endif %}
{% if use_context_delivery %}- F2/F4 adaptive route: classify the task and persist CONTEXT-PLAN.
  - LEXICAL_ENUMERATION: non-overlapping `rg` shards -> classification -> graph/LSP reachability.
  - KNOWN_SYMBOL_IMPACT: CodeGraph ∥ `rg` only for independently queryable high-radius/completeness work; resolve P4 after the join and use LSP when required.
  - DYNAMIC_STATE_FLOW: prove event -> data/state -> behavior locally before outward graph reachability.
  - DOCS_OR_CONFIG: canonical docs + textual search + focused reads.
  - DIRECT_TARGETED: focused text/semantic route without ceremonial fan-out.
{% else %}- F2: use `rg` and focused reads for lexical discovery. Use graph/LSP only when the question requires semantic identity or transitive reachability; do not launch all tools by default.
{% endif %}{% if harness_understand_apps_root %}
- Architecture provider: Understand Anything under `{{ harness_understand_apps_root }}/`; incremental paths are relative to that graph root. Freshness: `bash .harness/lib/understand-apps-changed-files.sh`.
{% endif %}{% if harness_mcp_db_dev_port and harness_mcp_db_dev_port > 0 %}
- F3 LIVE_STATE: query the read-only database/runtime source in parallel with independent code discovery. Permission failure is not absence of data.
{% endif %}
- Provider capabilities are version-specific. A graph miss never proves documentation absence; use docs routing/search for Markdown.
- F5: consult current official documentation for external libraries, SDKs and CLIs.
- Clarification is legitimate only after applicable phases; load `clarification-plan` before asking.
{% if use_context_delivery %}- New writable Council runs: ANCHOR -> CONTEXT-PLAN -> CONTEXT-DELIVERY -> PHASE-PLAN. A prose Context Brief is not proof.
{% endif %}</exploration-protocol-kickoff>"""


def main() -> int:
    try:
        data = json.load(sys.stdin)
        prompt = str(data.get("prompt") or "")
    except Exception:
        return 0
    if len(prompt) < MIN_LEN:
        return 0
    lowered = prompt.lower()
    if "exploration-protocol" in lowered or "context-delivery" in lowered:
        return 0
    if KICKOFF_RE.search(prompt):
        print(ROUTING)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
