#!/usr/bin/env python3
"""Inject the {{ project_name }} Understand Anything {{ harness_understand_apps_root }}/ diff rule into prompt context.

Claude hooks print stdout from UserPromptSubmit into the next model context. This
hook is intentionally narrow: it only fires when the prompt mentions the
Understand Anything workflow or its artifacts.

MATERIALIZATION (F4, orions-belt): generated only when
`harness_understand_apps_root` is set (see copier.yml) — the project uses a
monorepo subdirectory, not the git root, as the graph's PROJECT_ROOT. The
hardcoded graph hash from the donor-harness original was REMOVED (it desyncs on
every incremental /understand); the rule now always reads from meta.json.
"""
import json
import re
import sys

TRIGGER_RE = re.compile(
    r"(?i)(/understand|understand[- ]anything|\.understand-anything|knowledge-graph|"
    r"grafo\s+de\s+(codigo|c[oó]digo|conhecimento)|code\s+graph|compute-batches|changed-files\.txt)"
)

MESSAGE = """<understand-apps-incremental-guard>
BLOCKING RULE — Understand Anything in {{ project_name }}:
- Semantic scope of the product graph = {{ harness_understand_apps_root }}/.
- Real git root = repo root; {{ harness_understand_apps_root }}/ is a subdirectory.
- Therefore the incremental of {{ harness_understand_apps_root }}/ must NEVER use a raw diff:
  git diff <lastCommitHash>..HEAD --name-only
- ALWAYS use a diff relative to {{ harness_understand_apps_root }}:
  LAST=$(node -e "const fs=require('fs'); const m=JSON.parse(fs.readFileSync('{{ harness_understand_apps_root }}/.understand-anything/meta.json','utf8')); process.stdout.write(m.gitCommitHash)")
  git diff --relative={{ harness_understand_apps_root }} "$LAST"..HEAD --name-only -- {{ harness_understand_apps_root }} | rg -v '^\\.understand-anything/'
- The graph's reference hash is NOT a constant — always read it from
  {{ harness_understand_apps_root }}/.understand-anything/meta.json (gitCommitHash field, the LAST= command above).
- Prefer the canonical script:
  bash .harness/lib/understand-apps-changed-files.sh
- changed-files for compute-batches must contain api/..., web/..., cli/...; NEVER {{ harness_understand_apps_root }}/api/... or root paths.
- /understand --full is NOT incremental; --full forces a rebuild.
</understand-apps-incremental-guard>"""


def main() -> int:
    try:
        data = json.load(sys.stdin)
    except Exception:
        return 0
    prompt = data.get("prompt") or ""
    if TRIGGER_RE.search(prompt):
        print(MESSAGE)
    return 0


if __name__ == "__main__":
    sys.exit(main())
