#!/usr/bin/env bash
# git-doctor — SessionStart. DETECTS (does not destructively auto-mutate) git state
# that poisons the session and reports it with the repair command + push status.
# Origin: friction audit 2026-07-03, cluster 8 (abandoned rebase-merge
# polluted weeks of SessionStart; push became a negotiation).
# Philosophy: SessionStart does NOT abort rebase/merge on its own (too irreversible
# to automate). It only makes a non-destructive backup (stash -u if dirty) and guides.
set -uo pipefail
ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null)}"
[ -n "$ROOT" ] || exit 0
cd "$ROOT" || exit 0
GD=$(git rev-parse --git-dir 2>/dev/null) || exit 0

MSG=""
if [ -d "$GD/rebase-merge" ] || [ -d "$GD/rebase-apply" ]; then
  MSG+="REBASE PENDING in progress (.git/rebase-*). This breaks SessionStart:resume and becomes \"Cannot rebase onto multiple branches\".\n"
  MSG+="  Resolve: 'git rebase --abort' (discards the rebase) or '--continue' (if you know what you are doing).\n"
fi
if [ -f "$GD/MERGE_HEAD" ]; then
  MSG+="MERGE PENDING (.git/MERGE_HEAD). Resolve conflicts and commit, or 'git merge --abort'.\n"
fi

if [ -n "$MSG" ]; then
  # NON-destructive backup of the dirty working tree before anything the
  # user/agent does next (we do not abort ourselves; we only protect the content).
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    git stash push -u -m "git-doctor backup $(date +%FT%T)" >/dev/null 2>&1 \
      && MSG+="Dirty working tree → saved in 'git stash' (git stash pop to recover).\n"
  fi
  {
    echo "<git-doctor-alert>"
    echo -e "$MSG"
    echo "Do NOT proceed with new work before cleaning up the state above."
    echo "</git-doctor-alert>"
  }
  exit 0
fi

# Clean repo: report push status only if there are commits ahead of the remote
AHEAD=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0)
if [ "${AHEAD:-0}" -gt 0 ]; then
  echo "<git-doctor-info>${AHEAD} commit(s) ahead of origin.{% if git_remote_url %} Push uses SSH ({{ git_remote_url }}).{% endif %} Credential ladder and delivery rules: git-delivery skill.</git-doctor-info>"
fi
exit 0
