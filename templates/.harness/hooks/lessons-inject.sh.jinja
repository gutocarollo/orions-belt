#!/usr/bin/env bash
# SessionStart hook — injects the lessons file into the context (AGENTS.md/CLAUDE.md
# §16, self-improvement loop). Output on stdout becomes session context. Line cap
# so the prompt is not inflated.
#
# MATERIALIZATION (F4, orions-belt): the lessons file path
# (HARNESS_LESSONS_FILE, default tasks/lessons.md) and the line cap
# (HARNESS_LESSONS_INJECT_MAX_LINES, default 80) come from .harness/harness.conf
# via .harness/lib/_tooling_conf.py — same pattern as subagent-throttle.sh
# (F0). The donor harness original had both hardcoded (path and MAX_LINES=80).
set -euo pipefail
ROOT="${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
CONF_PY="$ROOT/.harness/lib/_tooling_conf.py"

_conf_get() {
  # $1=key $2=default
  local val
  if command -v python3 >/dev/null 2>&1 && [ -f "$CONF_PY" ]; then
    val="$(HARNESS_PROJECT_ROOT="$ROOT" python3 "$CONF_PY" get "$1" "$2" 2>/dev/null)"
    [ -n "$val" ] && { echo "$val"; return 0; }
  fi
  echo "$2"
}
_conf_int() {
  local val
  if command -v python3 >/dev/null 2>&1 && [ -f "$CONF_PY" ]; then
    val="$(HARNESS_PROJECT_ROOT="$ROOT" python3 "$CONF_PY" getint "$1" "$2" 2>/dev/null)"
    [[ "$val" =~ ^-?[0-9]+$ ]] && { echo "$val"; return 0; }
  fi
  echo "$2"
}

LESSONS_FILE_REL="$(_conf_get HARNESS_LESSONS_FILE tasks/lessons.md)"
MAX_LINES="$(_conf_int HARNESS_LESSONS_INJECT_MAX_LINES 80)"
FILE="$ROOT/$LESSONS_FILE_REL"
[ -f "$FILE" ] || exit 0
TOTAL="$(wc -l < "$FILE" | tr -d ' ')"
echo "<lessons-learned source=\"$LESSONS_FILE_REL\">"
echo "Lessons from previous sessions (AGENTS.md/CLAUDE.md §16). Re-read the ones for the current task's domain; after a user correction, append immediately; 2nd recurrence → promote to a rule/hook."
# TRUNCATION IS ANNOUNCED, NEVER SILENT (adopter report, 2026-07-30). `tail -n` drops the
# BEGINNING of the file — the OLDEST lessons — and the instruction text in the donor CLAUDE.md
# claimed the opposite ("cuts the end"), so an adopter at 84 lines against a cap of 80 was losing
# the file header on every SessionStart and would have lost lesson #1 on the next append, while
# the written rule told them to protect the wrong end of the file. A cap that trims without
# saying so produces exactly the class of defect this harness exists to prevent: a signal the
# agent cannot see. The warning names the direction, the count and the two ways out, so the
# adopter chooses between promoting old lessons to permanent rules (preferred — a bigger cap
# costs context in EVERY session) and raising the cap.
if [ "$TOTAL" -gt "$MAX_LINES" ]; then
  echo "WARNING — lessons truncated: this file has ${TOTAL} lines and the cap is ${MAX_LINES}, so the FIRST $((TOTAL - MAX_LINES)) line(s) (the OLDEST lessons) are NOT in this context. Fix by promoting old lessons to a permanent rule/hook and deleting them here (preferred), or by raising HARNESS_LESSONS_INJECT_MAX_LINES in .harness/answers.yml. Headroom check: echo \$(( ${MAX_LINES} - \$(wc -l < ${LESSONS_FILE_REL}) ))"
fi
tail -n "$MAX_LINES" "$FILE"
echo "</lessons-learned>"
