# NOTA: .harness/answers.yml e .harness/harness.conf NÃO entram aqui de propósito.
# Este repo é o TEMPLATE (agent-harness em si) — não é um projeto-alvo com Copier já
# rodado. Quando este framework for instalado EM um projeto-alvo, o answers.yml e o
# harness.conf gerados lá são o config central do projeto e devem ser versionados.

# --- orions-belt self-install (dogfood, D1 Option B) ---
# This repo IS the orions-belt template, so a self-install renders an instance that
# byte-for-byte DUPLICATES templates/. We keep that instance LOCAL and regenerable
# (./harness-install.sh . --vcs-ref HEAD) instead of committing ~170 duplicates that
# would drift from the source. The durable, git-tracked shared memory is docs/log.md
# (hand-maintained, preserved on install). Already-tracked files (.claude/loop.md)
# stay tracked — git ignores these rules for files already under version control.
# A fresh clone self-announces it needs install via the SessionStart freshness hook.
/.agents/
/.codex/
/.harness/
/.githooks/
/.claude/
/tasks/
/tests/
/AGENTS.md
/docs/SCHEMA.md

# orions-belt:begin (harness-install) — generated by orions-belt; content between
# the markers is rewritten on every harness-install/copier update, do NOT edit
# inside this block. Lines ABOVE the block belong to the project and are never touched.
# .gitignore — minimal Orion's Belt seed (G10, post-v1.0.0 adversarial review).
# Covers only what the harness ITSELF generates at runtime and should never be
# committed — it does not try to be a generic language/stack .gitignore (that is
# project content). First install: created from scratch. If the project already
# has a .gitignore, Copier treats it like any other pre-existing file (conflict
# prompt / manual merge) — same mechanics as any template file.

# Visual evidence (PNG + manifest per run) — regenerated on every capture, not a
# committable source of truth (ui-evidence skill, manual chapter 09).
.claude/evidence/

# Durable state of long runs (marathon) — RUN.md per in-progress run; a work
# artifact, not history to preserve (chapter 08).
.harness/runs/

# Python bytecode of the modules shipped under .harness/lib/ — the hooks import
# _tooling_conf.py via `python3 .../script.py` on every fire (Edit/Write/Stop),
# which materializes __pycache__/ on the very first commit if this .gitignore is
# not in place before `git add -A`.
__pycache__/
*.py[cod]
# orions-belt:end
