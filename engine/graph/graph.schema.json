{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orions-belt.dev/schemas/control-graph.schema.json",
  "title": "Orion's Belt control graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "version", "start", "terminal", "nodes", "transitions", "budgets"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "graph_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "start": {"type": "string"},
    "terminal": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "nodes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["action", "router", "review", "human", "proof", "terminal"]},
          "review_family": {"enum": ["plan", "execution"]}
        }
      }
    },
    "transitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from", "to", "on"],
        "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "on": {"type": "string", "minLength": 1}}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
