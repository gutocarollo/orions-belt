{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orions-belt.dev/schemas/knowledge-graph.schema.json",
  "title": "Orion's Belt provider-neutral knowledge graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "nodes", "edges", "tombstones"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "provider_version", "git_commit", "project_root"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "provider_version": {"type": "string", "minLength": 1},
        "git_commit": {"type": "string", "minLength": 1},
        "project_root": {"type": "string", "minLength": 1}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "tombstones": {"type": "array", "items": {"$ref": "#/$defs/tombstone"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source", "recorded_at"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "model": {"type": "string"},
        "rule": {"type": "string"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "key", "locator", "content_hash", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^node:[a-f0-9]{24}$"},
        "kind": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type", "edge_class", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^edge:[a-f0-9]{24}$"},
        "source": {"type": "string", "pattern": "^node:[a-f0-9]{24}$"},
        "target": {"type": "string", "pattern": "^node:[a-f0-9]{24}$"},
        "type": {"type": "string", "minLength": 1},
        "edge_class": {"enum": ["deterministic", "compiler_resolved", "llm_inferred"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      },
      "allOf": [
        {
          "if": {"properties": {"edge_class": {"const": "llm_inferred"}}},
          "then": {"required": ["confidence"]}
        }
      ]
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entity_id", "entity_type", "deleted_at", "provenance"],
      "properties": {
        "id": {"type": "string", "pattern": "^tombstone:[a-f0-9]{24}$"},
        "entity_id": {"type": "string", "minLength": 1},
        "entity_type": {"enum": ["node", "edge"]},
        "deleted_at": {"type": "string", "format": "date-time"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
